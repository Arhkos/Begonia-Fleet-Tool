# =====================================================================
# Begonia Fleet Tool - .gitignore
# =====================================================================

# Dossier d'archives et anciens scripts non utilises
OLD/
*.old
*.bak

# ROMs volumineuses (> 100 Mo) — hebergees sur GitHub Releases
roms/*.zip
roms/*.img
**/roms/*.zip
**/roms/*.img
stock_firmware/images/

# Sauvegardes locales et dumps memoire
backup/
backup_*/
**/backup/
dandelion_tool/backup/

# Fichiers temporaires d'execution, captures et etats locaux
dandelion_tool/.state
dandelion_tool/hwparam.json
dandelion_tool/magisk_su_tab.xml
dandelion_tool/screen.png
*.png
*.xml
.state
hwparam.json

# Archives volumineuses et sauvegardes locales
*.tgz
*.tar.gz
*.7z

# Fichiers temporaires Python et caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
src/mtkclient/

# Logs et sorties d'execution locales
*.log
logs/
.system_generated/

# Configuration IDE et OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
