;
; Android WinUsb driver installation.
;
[Version]
Signature           = "$Windows NT$"
Class               = AndroidUsbDeviceClass
ClassGuid           = {3F966BD9-FA04-4ec5-9B19-F815E69311DE}
Provider            = %ProviderName%
DriverVer           = 08/28/2022,13.0.0000.00000

[ClassInstall32]
Addreg = AndroidWinUsbClassInstall

[AndroidWinUsbClassInstall]
HKR,,,0,%ClassName%
HKR,,Icon,,-1

[Manufacturer]
%ProviderName% = Google, NTamd64

[Google.NTamd64]
%SingleBootLoaderInterface% = USB_Install, USB\VID_18D1&PID_D00D
%SingleBootLoaderInterface% = USB_Install, USB\VID_18D1&PID_D00D&REV_0100
%SingleBootLoaderInterface% = USB_Install, USB\VID_18D1&PID_4EE0
%SingleBootLoaderInterface% = USB_Install, USB\VID_18D1&PID_4EE7

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
AddService = WinUsb,0x00000002,WinUsb_ServiceInstall

[WinUsb_ServiceInstall]
DisplayName     = %WinUSB_ServiceDisplayName%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407d-8814-9ED673D0DD6B}"

[Strings]
ProviderName                = "Google, Inc."
SingleBootLoaderInterface   = "Android Bootloader Interface"
WinUSB_ServiceDisplayName   = "Android USB Driver"
ClassName                   = "Android Device"
